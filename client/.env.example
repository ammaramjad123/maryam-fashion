# Base URL for the API. Left EMPTY by default so requests go through the Vite
# dev proxy (/api -> http://localhost:5000) in dev, or the same origin in prod
# when the server serves the built client. Set it only for a SPLIT deploy where
# the client (Vercel) talks to a separate backend (Render):
#   VITE_API_BASE_URL=https://your-api.onrender.com
VITE_API_BASE_URL=
