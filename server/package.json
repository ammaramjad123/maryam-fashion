{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API for the garments shop day-end system (Express + Mongoose).",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "seed:admin": "node src/scripts/seedAdmin.js",
    "seed:masters": "node src/scripts/seedMasters.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:demo": "node src/scripts/seedDemo.js",
    "backup": "bash ../scripts/backup.sh",
    "restore": "bash ../scripts/restore.sh",
    "golive:verify": "node src/scripts/goliveVerify.js",
    "golive:setup": "node src/scripts/goliveSetup.js",
    "reset:golive": "node src/scripts/resetGolive.js",
    "cleanup:empty-drafts": "node src/scripts/cleanupEmptyDrafts.js",
    "resequence:pages": "node src/scripts/resequencePages.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.3",
    "morgan": "^1.10.0",
    "puppeteer": "^25.3.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.2",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0",
    "vitest": "^2.1.8"
  }
}
