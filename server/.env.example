# ─── Server ───────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────────────────────
# post/unpost use a transaction, which REQUIRES a replica set (docs/08 Q9).
#   • Local: run mongod with `--replSet rs0` and `rs.initiate()` once.
#   • Cloud: MongoDB Atlas M0 (free) is already a replica set — paste its URI.
MONGODB_URI=mongodb://127.0.0.1:27017/garments_day_end?replicaSet=rs0

# ─── CORS ─────────────────────────────────────────────────────────────────
# The browser origin allowed to call the API. When the server also serves the
# built client (single origin) this is unused; needed only for split deploys.
#   • Local dev (Vite):  http://localhost:5173
#   • Split deploy:      https://your-app.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# ─── JWT ──────────────────────────────────────────────────────────────────
# In production this MUST be a long random string (>= 32 chars) or the server
# refuses to start. Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=7d

# ─── PDF renderer ─────────────────────────────────────────────────────────
# Where Puppeteer loads the /print pages. Empty → derive from the request (the
# server serves the built client). Set to http://localhost:5173 to render live
# client edits during development.
PRINT_BASE_URL=

# ─── Seed admin (npm run seed:admin -w server) ────────────────────────────
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@shop.local
SEED_ADMIN_PASSWORD=change-me-please
